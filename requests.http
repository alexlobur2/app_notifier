###############################################
# ПРИМЕРЫ С АВТОМАТИЧЕСКИМИ ТЕСТАМИ
###############################################

### Пример с проверкой наличия поля в ответе
GET http://{{local_host}}/api/v1/get_announces
Content-Type: application/json

{
  "app_id": "com.example.app",
  "device_id": "device123",
  "version": "1.0.0",
  "platform": "ios"
}

> {% 
    client.test("Response has announces array", function() {
      client.assert(response.body.announces !== undefined, "Response should have 'announces' field");
      client.assert(Array.isArray(response.body.announces), "'announces' should be an array");
    });
    
    client.test("Status code is 200", function() {
      client.assert(response.status === 200, "Response status is not 200");
    });
  %}

### Пример с извлечением токена из ответа и использованием в следующем запросе
# Этот пример показывает, как сохранить значение из ответа для использования в последующих запросах
POST http://{{local_host}}/api/v1/admin/announces
Content-Type: application/json
X-Auth-Token: {{local_token}}

{
  "app_id": "com.example.app",
  "title": "Тестовый анонс",
  "text": "Текст тестового анонса",
  "status": "active",
  "priority": 5,
  "platforms": ["ios"]
}

> {% 
    // Сохраняем ID созданного анонса для последующего использования
    if (response.body.announce && response.body.announce.id) {
      client.global.set("created_announce_id", response.body.announce.id);
      console.log("Created announce ID: " + response.body.announce.id);
    }
  %}

### Использование сохраненного ID для получения анонса
GET http://{{local_host}}/api/v1/admin/announces/{{created_announce_id}}
Content-Type: application/json
X-Auth-Token: {{local_token}}

> {% client.test("Status code is 200", function() {
    client.assert(response.status === 200, "Response status is not 200");
  }); %}

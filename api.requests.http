### An API - HTTP Requests for PhpStorm
### Base URL: http://localhost/api/index.php
### Все запросы отправляются методом POST с Content-Type: application/json

@baseUrl = https://services.locode.me/app_notifier/api/index.php
@adminToken = TEST_ADMIN
@appToken = TEST_APP
@appTokenDisabled = TEST_APP_DISABLED


### Public Announces - Получение списка активных анонсов
# Возвращает только анонсы со статусом "live"
POST {{baseUrl}}
Content-Type: application/json

{
  "action": "get_announces",
  "token": "{{appToken}}",
  "data": {
    "exclude_uuids": ["uuid1", "uuid2"],
    "device_fpt": "device_fingerprint_12345"
  }
}

### Public Announces - без параметров исключения
POST {{baseUrl}}
Content-Type: application/json

{
  "action": "get_announces",
  "token": "{{appToken}}",
  "data": {
    "device_fpt": "my_device_fingerprint"
  }
}

### Public Announces - приложение выключено
POST {{baseUrl}}
Content-Type: application/json

{
  "action": "get_announces",
  "token": "{{appTokenDisabled}}",
  "data": {
    "device_fpt": "my_device_fingerprint"
  }
}



### Adm Announces List - Список всех анонсов с пагинацией
POST {{baseUrl}}
Content-Type: application/json

{
  "action": "adm.announces.list",
  "token": "{{adminToken}}",
  "data": {
    "apps_ids": ["app1", "app2"],
    "statuses": ["draft", "live", "archived"],
    "pagination": {
      "offset": 0,
      "limit": 100,
      "order": "created_at",
      "desc": false
    }
  }
}

### Adm Announces List - без фильтрации (все анонсы)
POST {{baseUrl}}
Content-Type: application/json

{
  "action": "adm.announces.list",
  "token": "{{adminToken}}",
  "data": {}
}

### Adm Announces Upsert - Создание нового анонса
POST {{baseUrl}}
Content-Type: application/json

{
  "action": "adm.announces.upsert",
  "token": "{{adminToken}}",
  "data": {
    "announce": {
      "app_id": "test.app",
      "title": "Заголовок анонса",
      "body": "Текст анонса",
      "status": "draft",
      "start_at": 1735689600,
      "end_at": 1738368000
    }
  }
}

### Adm Announces Upsert - Обновление существующего анонса
POST {{baseUrl}}
Content-Type: application/json

{
  "action": "adm.announces.upsert",
  "token": "{{adminToken}}",
  "data": {
    "announce": {
      "uuid": "existing-uuid",
      "app_id": "test.app",
      "title": "Обновленный заголовок",
      "body": "Текст анонса",
      "status": "draft",
      "start_at": 1735689600,
      "end_at": 1738368000
    }
  }
}

### Adm Announces Delete - Удаление анонсов по UUID
POST {{baseUrl}}
Content-Type: application/json

{
  "action": "adm.announces.delete",
  "token": "{{adminToken}}",
  "data": {
    "uuids": ["existing-uuid", "uuid1", "uuid2"]
  }
}



### Adm Apps List - Получить список всех приложений
POST {{baseUrl}}
Content-Type: application/json

{
  "action": "adm.apps.list",
  "token": "{{adminToken}}",
  "data": {}
}

### Adm Apps Upsert - Создание нового приложения
POST {{baseUrl}}
Content-Type: application/json

{
  "action": "adm.apps.upsert",
  "token": "{{adminToken}}",
  "data": {
    "app": {
      "app_id": "new_app_123",
      "token": "custom_app_token_here",
      "enabled": true
    }
  }
}

### Adm Apps Upsert - Обновление существующего приложения
POST {{baseUrl}}
Content-Type: application/json

{
  "action": "adm.apps.upsert",
  "token": "{{adminToken}}",
  "data": {
    "app": {
      "app_id": "existing_app_123",
      "token": "updated_token_here",
      "enabled": false
    }
  }
}

### Adm Apps Delete - Удаление приложений по ID
POST {{baseUrl}}
Content-Type: application/json

{
  "action": "adm.apps.delete",
  "token": "{{adminToken}}",
  "data": {
    "apps_ids": ["new_app_123", "app2", "app3"]
  }
}



### Adm Devices List - Список устройств с пагинацией
POST {{baseUrl}}
Content-Type: application/json

{
  "action": "adm.devices.list",
  "token": "{{adminToken}}",
  "data": {
    "apps_ids": ["test.app", "app2"],
    "pagination": {
      "offset": 0,
      "limit": 100,
      "order": "last_seen_at",
      "desc": true
    }
  }
}

### Adm Devices List - все устройства без фильтрации
POST {{baseUrl}}
Content-Type: application/json

{
  "action": "adm.devices.list",
  "token": "{{adminToken}}",
  "data": {}
}


### Неверный токен (ошибка 401 Unauthorized)
POST {{baseUrl}}
Content-Type: application/json

{
  "action": "adm.apps.list",
  "token": "invalid_token",
  "data": {}
}

### Неизвестное действие (ошибка 400 Bad Request)
POST {{baseUrl}}
Content-Type: application/json

{
  "action": "unknown_action",
  "token": "{{adminToken}}",
  "data": {}
}

### Отсутствует поле action (ошибка 400 Bad Request)
POST {{baseUrl}}
Content-Type: application/json

{
  "token": "{{adminToken}}",
  "data": {}
}

### Недостаточно прав для админ действия (ошибка 403 Forbidden)
POST {{baseUrl}}
Content-Type: application/json

{
  "action": "adm.announces.list",
  "token": "{{appToken}}",
  "data": {}
}
